VITE_API_URL=http://localhost:9000/api
VITE_SOCKET_URL=http://localhost:9000

# ==============================================================================
# MAP VISUALIZATION & GIS API CONFIGURATION
# ==============================================================================
# MapTiler API Key (Rekomendasi untuk Vector/Raster Tiles resolusi tinggi: Dark, Streets, Satellite Hybrid, Outdoor)
# Daftar gratis di: https://cloud.maptiler.com/
VITE_MAPTILER_KEY=your_maptiler_key_here
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# Mapbox Access Token (Opsional jika ingin menggunakan tile Mapbox Studio / Mapbox GL)
# Daftar di: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=

# Stadia Maps API Key (Opsional untuk Alidade Smooth Dark / Stamen Watercolor / Terrain)
# Daftar di: https://stadiamaps.com/
VITE_STADIA_MAPS_API_KEY=

# OpenStreetMap Nominatim Geocoding API (Default: Server publik OSM)
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Open Source Routing Machine (OSRM) Engine Endpoint
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org
