{
  "name": "koling-backend",
  "version": "1.0.0",
  "description": "Koling (MantaKopi DSS) Backend powered by Bun and TypeScript",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/scripts/migrate.ts",
    "db:reset": "bun src/scripts/reset-db.ts",
    "db:seed": "bun src/scripts/seed.ts",
    "db:setup": "bun src/scripts/setup-db.ts",
    "db:init": "bun src/scripts/setup-db.ts",
    "db:recluster": "bun src/scripts/recluster-poi.ts",
    "fetch:weather": "bun src/scripts/fetch-weather.ts",
    "sync:toll-roads": "bun src/scripts/sync-toll-roads.ts",
    "test": "bun src/scripts/test-runner.ts integration",
    "test:unit": "bun src/scripts/test-runner.ts unit",
    "test:integration": "bun src/scripts/test-runner.ts integration",
    "test:e2e": "bun src/scripts/test-runner.ts e2e",
    "test:smoke": "bun src/scripts/test-runner.ts smoke"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.7",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "ioredis": "^6.0.0",
    "javascript-lp-solver": "^1.0.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.5",
    "openmeteo": "^1.2.3",
    "pg": "^8.22.0",
    "pg-format": "^1.0.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.1.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/pg-format": "^1.0.3",
    "typescript": "^5.7.3"
  }
}
