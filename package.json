{
  "name": "koling-app-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Koling App Multi-Project Workspace Container",
  "scripts": {
    "dev": "cd mova_app/multi-tenant && bun dev.ts",
    "dev:mova": "cd mova_app/multi-tenant && bun dev.ts",
    "dev:mova:multi": "cd mova_app/multi-tenant && bun dev.ts",
    "dev:mova:multi:backend": "cd mova_app/multi-tenant/backend && bun run dev",
    "dev:mova:multi:frontend": "cd mova_app/multi-tenant/frontend && bun run dev",
    "dev:mova:single:backend": "cd mova_app/single-tenant/backend && npm run dev",
    "dev:mova:single:frontend": "cd mova_app/single-tenant/frontend && npm run dev",
    "audit:mova:single": "cd mova_app/single-tenant/backend && node src/scripts/audit_ui_requirements.js",
    "build:mova:multi": "cd mova_app/multi-tenant/frontend && bun run build",
    "build:mova:single": "cd mova_app/single-tenant/frontend && npm run build",
    "prod:mova:start": "cd mova_app/multi-tenant && bun run build && pm2 start ecosystem.config.cjs",
    "prod:mova:stop": "cd mova_app/multi-tenant && (pm2 stop ecosystem.config.cjs 2>/dev/null || fuser -k 9967/tcp 9968/tcp 2>/dev/null || true)",
    "prod:mova:restart": "cd mova_app/multi-tenant && pm2 restart ecosystem.config.cjs"
  }
}
